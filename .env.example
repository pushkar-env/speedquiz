# Application
APP_NAME=SpeedQuiz
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,*

# Database
POSTGRES_USER=speedquiz
POSTGRES_PASSWORD=speedquiz_dev_password
POSTGRES_DB=speedquiz
DATABASE_URL=postgresql+asyncpg://speedquiz:speedquiz_dev_password@postgres:5432/speedquiz
DATABASE_URL_SYNC=postgresql+psycopg://speedquiz:speedquiz_dev_password@postgres:5432/speedquiz

# Database connection pool (per process).
# Total server connections = (POOL_SIZE + MAX_OVERFLOW) x WEB_CONCURRENCY x replicas.
# Postgres defaults to max_connections=100 — do the multiplication before raising these.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
# REQUIRED behind a transaction-mode pooler (PgBouncer / Supavisor / Neon `-pooler`).
DB_DISABLE_PREPARED_STATEMENTS=false

# Uvicorn worker processes (read by Dockerfile.api).
WEB_CONCURRENCY=2

# Redis
REDIS_URL=redis://redis:6379/0
# Redis is in the answer-submission path; fail fast rather than stall handlers.
REDIS_SOCKET_TIMEOUT_SECONDS=3
REDIS_CONNECT_TIMEOUT_SECONDS=3
REDIS_MAX_CONNECTIONS=50

# Serve /docs, /redoc, /openapi.json when APP_ENV=production.
ENABLE_DOCS_IN_PRODUCTION=false

# Auth / JWT
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# LLM (keys stay on the backend only)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL_GENERATE=gpt-4o-mini
LLM_MODEL_VALIDATE=gpt-4o-mini
LLM_MODEL_CLASSIFY=gpt-4o-mini

# OAuth (Google Sign-In — Web client ID; also used as Flutter serverClientId)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Observability
SENTRY_DSN=
LOG_LEVEL=INFO

# Scoring defaults
SCORE_BASE_POINTS=100
SCORE_SPEED_BONUS_MAX=50
STREAK_MULTIPLIER_TIERS=0:1.0,5:1.1,10:1.25,20:1.5

# Generation / cost control
CUSTOM_TOPIC_DAILY_LIMIT_FREE=3
QUESTION_QUALITY_THRESHOLD=70
GENERATION_BATCH_SIZE=10

# Question bank growth (async worker chunks; gameplay stays on Postgres)
TOPIC_BANK_TARGET_UNIQUE=1000
TOPIC_BANK_LOW_WATERMARK=40
TOPIC_BANK_CHUNK_SIZE=20
TOPIC_BANK_SESSION_BATCH=20

# Monetization (keep free unlimited until enabled)
ENTITLEMENTS_ENFORCE_QUESTION_CAPS=false
FREE_UNIQUE_QUESTIONS_PER_TOPIC=30
# Allow POST /entitlements/dev/premium even in production-like envs (dev only)
ENTITLEMENTS_DEV_TOGGLE=false

# --- Subscription products (create these ids in BOTH consoles) ---
# On Apple, both must sit in ONE subscription group so switching plans is an
# upgrade/downgrade rather than two concurrent subscriptions.
IAP_PRODUCT_MONTHLY=speedquiz_premium_monthly
IAP_PRODUCT_ANNUAL=speedquiz_premium_annual
# Retired one-time unlock. Still honoured on verify/restore; never sold again.
IAP_PREMIUM_PRODUCT_ID=speedquiz_premium
IAP_ANDROID_PACKAGE=com.speedquiz.app

# stub = accept tokens in non-prod; apple_google = App Store / Play verify adapters
BILLING_VERIFY_MODE=stub
BILLING_ALLOW_STUB_IN_PRODUCTION=false
# Days past expiry to keep serving premium when the store is still retrying a
# failed renewal but has not granted an explicit grace period. India's card
# e-mandates fail on renewal far more often than US cards.
BILLING_GRACE_PERIOD_DAYS=3
BILLING_RESYNC_STALE_HOURS=24

# Google Play service account JSON (single line). Empty = 503 under apple_google.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Real-time developer notifications (Pub/Sub push). Set at least one in
# production or POST /billing/webhooks/google refuses to process.
GOOGLE_RTDN_SHARED_SECRET=
GOOGLE_RTDN_OIDC_AUDIENCE=
GOOGLE_RTDN_OIDC_SERVICE_ACCOUNT=

# Apple App Store Server API (.p8 PEM with \n escapes). Empty = 503 under apple_google.
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_BUNDLE_ID=com.speedquiz.app
# Sandbox | Production
APPLE_IAP_ENVIRONMENT=Sandbox
# App Store notifications are signed but the endpoint is public, so the JWS
# chain must be pinned to Apple's root or anyone could forge a subscription
# event. Production refuses to boot without it when Apple IAP is configured.
#   curl -o backend/certs/AppleRootCA-G3.cer \
#     https://www.apple.com/certificateauthority/AppleRootCA-G3.cer
APPLE_ROOT_CA_PATH=certs/AppleRootCA-G3.cer
APPLE_ROOT_CA_PEM=
# Public share landing base (empty = omit web_url). Example local: http://localhost:8000
SHARE_PUBLIC_BASE_URL=
# App Links / Universal Links (point domain at API; leave empty until ready)
APP_LINK_ANDROID_PACKAGE=com.speedquiz.app
APP_LINK_ANDROID_SHA256_CERT_FINGERPRINTS=
# TEAMID.com.speedquiz.app
APP_LINK_IOS_APP_ID=

# Analytics: postgres | null
ANALYTICS_PROVIDER=postgres

# --- Multiplayer ---
MULTIPLAYER_ENABLED=true
MATCH_DEFAULT_QUESTION_COUNT=7
MATCH_QUESTION_TIME_LIMIT_MS=15000
# Pause between rounds so the verdict is readable before the next prompt.
MATCH_ROUND_REVEAL_MS=3000
MATCH_MAX_PLAYERS=8
# A challenged friend who never connects turns the match async after this
# rather than leaving the challenger on a spinner.
MATCH_LIVE_JOIN_GRACE_SECONDS=45
# How long an async challenge waits for its opponent before it is settled on
# the scores that exist.
MATCH_ASYNC_EXPIRY_HOURS=48

# Realtime channel (Redis Streams + WebSocket).
# NOTE: the Cloudflare Worker in infrastructure/cloudflare-worker must be
# redeployed for WebSockets to reach the API — see its worker.js.
REALTIME_STREAM_MAXLEN=500
REALTIME_TICKET_TTL_SECONDS=60
REALTIME_HEARTBEAT_SECONDS=20

# Ranked ladder. Only rated 1v1 duels move these; friend challenges never do.
RANKED_STARTING_RATING=1000
RANKED_K_FACTOR=24
RANKED_PLACEMENT_K_FACTOR=48
RANKED_PLACEMENT_MATCHES=5
# Season rollover keeps ordering but pulls toward the mean (0 = full reset).
RANKED_SEASON_CARRYOVER=0.6
MATCHMAKING_INITIAL_BAND=100
MATCHMAKING_MAX_BAND=800
MATCHMAKING_TIMEOUT_SECONDS=60

# Extra blocked username substrings, comma separated. Matched against the
# folded form, so `sh1t` is caught by `shit`.
USERNAME_BLOCKED_TERMS=

# --- Player-authored quizzes ---
CUSTOM_QUIZ_ENABLED=true
# Published quizzes a free account may hold. Drafts are not counted — an
# unfinished quiz is not content anyone can reach, and charging for it just
# teaches players not to start one.
CUSTOM_QUIZ_FREE_LIMIT=3
CUSTOM_QUIZ_FREE_MAX_QUESTIONS=20
# Hard ceiling for everyone. Above this the editor stops being a form.
CUSTOM_QUIZ_MAX_QUESTIONS=50
# Publish floor. Must stay >= MATCH_MIN_QUESTION_COUNT, or a published quiz
# could still refuse every challenge sent on it.
CUSTOM_QUIZ_MIN_QUESTIONS=3
# "Draft with AI" — starter questions the author then edits. Quota'd like
# custom AI topics; premium is unlimited.
CUSTOM_QUIZ_AI_DRAFT_MAX=10
CUSTOM_QUIZ_AI_DRAFT_DAILY_LIMIT_FREE=3
# Distinct reporters that auto-hide a quiz pending review. Low on purpose:
# these are link-shared, so three unrelated people objecting is a lot.
CUSTOM_QUIZ_REPORT_HIDE_THRESHOLD=3
# How often finishing your *own* quiz can pay XP. Without this an author holds
# a private, infinitely repeatable XP faucet they wrote the answers to.
CUSTOM_QUIZ_OWN_XP_COOLDOWN_HOURS=24
CUSTOM_QUIZ_LEADERBOARD_SIZE=25

# --- Push notifications (FCM HTTP v1) ---
# Empty = push disabled. That is a supported state: the in-app inbox carries
# every notification, so multiplayer works without a Firebase project — it is
# just quieter. Paste the service-account JSON on one line.
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=
PUSH_ENABLED=true
# Local-time window where only "your turn" may interrupt. Applied per device
# using the UTC offset the client reports, not the server's clock.
PUSH_QUIET_HOURS_ENABLED=true
PUSH_QUIET_HOURS_START=22
PUSH_QUIET_HOURS_END=8

# The Flutter side of push. All four or none — a partial set builds an app that
# silently never registers. From Firebase console -> Project settings -> Your
# apps. Read by scripts/build_android.sh and passed as --dart-define.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_SENDER_ID=

# --- Production go-live ---
# See docs/DEPLOYMENT.md and docs/ENV_PROVIDERS.md
# Flutter release builds need: --dart-define=API_BASE_URL=https://your.domain
# Android signing: mobile/android/key.properties (from key.properties.example)
