# Application
APP_NAME=QuizVerse
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,*

# Database
POSTGRES_USER=quizverse
POSTGRES_PASSWORD=quizverse_dev_password
POSTGRES_DB=quizverse
DATABASE_URL=postgresql+asyncpg://quizverse:quizverse_dev_password@postgres:5432/quizverse
DATABASE_URL_SYNC=postgresql+psycopg://quizverse:quizverse_dev_password@postgres:5432/quizverse

# Redis
REDIS_URL=redis://redis:6379/0

# Auth / JWT
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# LLM (keys stay on the backend only)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL_GENERATE=gpt-4o-mini
LLM_MODEL_VALIDATE=gpt-4o-mini
LLM_MODEL_CLASSIFY=gpt-4o-mini

# OAuth (optional in Phase 1)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Observability
SENTRY_DSN=
LOG_LEVEL=INFO

# Scoring defaults
SCORE_BASE_POINTS=100
SCORE_SPEED_BONUS_MAX=50
STREAK_MULTIPLIER_TIERS=0:1.0,5:1.1,10:1.25,20:1.5

# Generation / cost control
CUSTOM_TOPIC_DAILY_LIMIT_FREE=3
QUESTION_QUALITY_THRESHOLD=70
GENERATION_BATCH_SIZE=10

# Question bank growth (async worker chunks; gameplay stays on Postgres)
TOPIC_BANK_TARGET_UNIQUE=1000
TOPIC_BANK_LOW_WATERMARK=40
TOPIC_BANK_CHUNK_SIZE=20
TOPIC_BANK_SESSION_BATCH=20

# Monetization roadmap (keep free unlimited until enabled)
ENTITLEMENTS_ENFORCE_QUESTION_CAPS=false
FREE_UNIQUE_QUESTIONS_PER_TOPIC=30
